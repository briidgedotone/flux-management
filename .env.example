# === Azure AD Authentication (MANAGEMENT-SPECIFIC) ===
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_REDIRECT_URI=http://localhost:3001/api/auth/callback

# === Database (SHARED with client portal) ===
DATABASE_URL=postgresql://user:password@localhost:5432/fluxdb

# === Azure Key Vault (SHARED — production only, local dev uses .env.local) ===
AZURE_KEY_VAULT_URL=

# === Atera API (SHARED with client portal) ===
ATERA_API_KEY=

# === Anthropic / Claude AI (SHARED with client portal) ===
ANTHROPIC_API_KEY=

# === JWT (MANAGEMENT-SPECIFIC — must be different from client portal) ===
JWT_SECRET=

# === Contact Form Webhook (MANAGEMENT-SPECIFIC) ===
CONTACT_WEBHOOK_SECRET=

# === App (MANAGEMENT-SPECIFIC) ===
NEXT_PUBLIC_APP_URL=http://localhost:3001
NODE_ENV=development
